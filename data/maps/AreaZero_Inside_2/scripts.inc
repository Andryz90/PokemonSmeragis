	setobjectxyperm AREAZERO_EDO_INSIDE_2, 10, 44
	setobjectmovementtype AREAZERO_ANDRY_INSIDE_2, MOVEMENT_TYPE_FACE_UP
	setobjectmovementtype AREAZERO_EDO_INSIDE_2, MOVEMENT_TYPE_FACE_UP
