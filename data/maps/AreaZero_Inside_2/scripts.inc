	clearflag FLAG_AREA_ZERO_INSIDE_2_REINFORCEMENTS
	clearflag FLAG_AREA_ZERO_INSIDE_2_BOTTOM_PARADOXES
	clearflag FLAG_AREA_ZERO_INSIDE_2_IRON_JUGULIS
